# Copy to .env (`uv run poe env` does it for you) and change the passwords.
# .env is git-ignored; never commit real credentials.

# --- Warehouse (PostgreSQL) ---
POSTGRES_USER=warehouse_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# --- Metabase application database (lives in the same Postgres instance) ---
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change-me-too
METABASE_PORT=3000

# Pin this to an exact release tag (e.g. v0.xx.y) once you have verified one,
# so every machine and CI run uses the same Metabase version.
METABASE_VERSION=latest
