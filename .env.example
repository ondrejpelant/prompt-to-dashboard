# Copy to .env (`uv run poe env` does it for you) and change the passwords.
# .env is git-ignored; never commit real credentials.

# --- Warehouse (PostgreSQL) ---
POSTGRES_USER=warehouse_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# --- Read-only warehouse login for Metabase and the LLM agent (core schema only) ---
BI_DB_USER=bi_reader
BI_DB_PASSWORD=change-me-as-well

# --- Metabase application database (lives in the same Postgres instance) ---
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change-me-too
METABASE_PORT=3000

# API key of the Administrators group, used by `uv run poe metabase`. Create it in
# Metabase: Admin settings > Settings > Authentication > API keys.
METABASE_API_KEY=

# Pin this to an exact release tag (e.g. v0.xx.y) once you have verified one,
# so every machine and CI run uses the same Metabase version.
METABASE_VERSION=v0.64.3.1
